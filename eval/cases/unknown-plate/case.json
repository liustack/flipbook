    "id": "unknown-plate",
    "title": "来源不明的图版",
    "asks": ["pictures", "rules"],
    "prompt": "我从网上存了一张老图版 downloads/f3a9c1e7.jpg，不记得是哪个网站的了。用它做一条 15 秒的短片，讲一只寄居蟹换壳。",
    "workspace": {
        "downloads/f3a9c1e7.jpg": {
            "generator": "repo",
            "from": "examples/specimen-board/assets/cone-shells.jpg"
        }
    },
    "expect": {
        "film": "optional",
        "durationSec": [14.25, 15.75],
