{
    "name": "@liustack/flipbook",
    "version": "0.5.3",
    "description": "Renderer for the flipbook agent skill: deterministic HTML-to-MP4 with built-in acceptance checks",
    "type": "module",
    "bin": {
        "flipbook": "dist/main.js"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project unit",
        "test:e2e": "vitest run --project e2e",
        "test:release": "vitest run --project release",
        "lint": "biome check",
        "format": "biome check --write",
        "release": "node scripts/release.mjs",
        "fonts:codepoints": "node scripts/build-codepoints.mjs",
        "examples:baseline": "pnpm build && node scripts/examples-baseline.mjs"
    },
    "files": [
        "dist",
        "docs/*.md",
        "skills/flipbook",
        "CHANGELOG.md",
        "SECURITY.md",
        "THIRD_PARTY_NOTICES.md"
    ],
    "keywords": [
        "cli",
        "video",
        "animation",
        "html-to-video",
        "mp4",
        "playwright",
        "agent-skill",
        "claude-code",
        "skill",
        "flipbook"
    ],
    "author": "Leon Liu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liustack/flipbook.git"
    },
    "bugs": {
        "url": "https://github.com/liustack/flipbook/issues"
    },
    "homepage": "https://github.com/liustack/flipbook#readme",
    "engines": {
        "node": ">=22.19"
    },
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "commander": "15.0.0",
        "playwright-core": "1.63.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/node": "^22.20.4",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
